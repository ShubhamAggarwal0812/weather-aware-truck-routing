# Truck routing and place search. Without it the app uses OSRM (car profile) + Photon.
# Free key, no card: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Optional paid Open-Meteo key (the free tier allows ~10k location-forecasts/day per IP).
OPEN_METEO_API_KEY=

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
