# Copy to .env (git-ignored). Read by the API in local dev and by `docker compose`.

# Truck routing and place search. Without it the API uses OSRM (car profile) + Photon.
# Free key, no card: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Optional paid Open-Meteo key; the free tier allows ~10k location-forecasts/day per IP.
OPEN_METEO_API_KEY=

# Shared rate-limit counters, so every process and instance counts the same requests.
# compose sets it; on Vercel the Redis Marketplace integration adds REDIS_URL or KV_URL.
# Use the redis:// or rediss:// address, not an https:// one. If Redis is down the API
# keeps answering, without rate limits.
# REDIS_URL=redis://localhost:6379/0
# How many proxies append to X-Forwarded-For in front of the API (nginx or Vercel: 1).
# NUM_PROXIES=1

# Production only (Vercel / Docker). Local dev uses config.settings.local.
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=.vercel.app,localhost
